# ---- provider credentials -------------------------------------------------
# The gateway is the only component that holds provider keys. Agents never do.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- state ----------------------------------------------------------------
# Leave REDIS_URL empty to run single-process with the in-memory store.
# Budgets and rate limits are only correct across workers with Redis set.
REDIS_URL=

# ---- auth -----------------------------------------------------------------
# dev  = trust X-Tenant-Id / X-Agent-Id headers (local only)
# jwt  = require a bearer JWT carrying tenant_id + agent_id claims
GATEWAY_AUTH_MODE=dev
GATEWAY_JWT_SECRET=change-me
GATEWAY_JWT_ALGORITHM=HS256

# ---- routing --------------------------------------------------------------
# Session stickiness window; should track your prompt-cache TTL.
GATEWAY_SESSION_TTL_SECONDS=300
# Cache-aware routing: subtract projected cache loss when scoring a model
# that differs from the session's currently warm model.
GATEWAY_CACHE_AWARE_ROUTING=true
# Allow mid-session tier increases only. De-escalation throws away a warm cache
# and almost never pays for itself.
GATEWAY_ESCALATE_ONLY=true
# Layer 3 of the classifier: a small-model call when rules+embeddings are unsure.
GATEWAY_LLM_CLASSIFIER_ENABLED=true
GATEWAY_CLASSIFIER_MODEL=claude-haiku-4-5
GATEWAY_CLASSIFIER_MIN_CONFIDENCE=0.6

# ---- cache ----------------------------------------------------------------
# Serialize the first request of an unseen prefix so parallel sub-agents read
# the cache the pilot writes, instead of all paying a cold write.
GATEWAY_CACHE_PILOT_ENABLED=true
GATEWAY_CACHE_PILOT_WAIT_MS=4000
# Anthropic cache_control TTL: 5m or 1h. 1h doubles write cost (2x vs 1.25x),
# so it needs >=3 reads to pay off. Default to 5m.
GATEWAY_CACHE_TTL=5m
# Semantic (embedding-similarity) response reuse. OFF by default: returning a
# near-miss answer mid-workflow is a correctness bug, not a saving.
GATEWAY_SEMANTIC_CACHE_ENABLED=false

# ---- governance -----------------------------------------------------------
GATEWAY_DEFAULT_TENANT_DAILY_USD=50.0
GATEWAY_DEFAULT_TENANT_RPM=600
# soft = degrade to the cheapest capable tier when over budget, then fail
# hard = reject immediately
GATEWAY_BUDGET_MODE=soft
# Run count_tokens for an exact pre-flight estimate only when a tenant is
# within this fraction of their cap. An extra round trip on every call is not free.
GATEWAY_PREFLIGHT_EXACT_THRESHOLD=0.85

# ---- observability --------------------------------------------------------
GATEWAY_RECORD_PATH=./var/records.jsonl
GATEWAY_LOG_LEVEL=INFO
